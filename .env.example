# ─────────────────────────────────────────────────────────────
# mart25 Mini App — environment variables
# Copy to .env (repo root) and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string (docker compose up -d db gives you this one)
DATABASE_URL=postgres://market:market@localhost:5432/market_dev
# Set true for managed Postgres that requires TLS (Neon, Supabase, RDS…)
DATABASE_SSL=false
# Apply migrations automatically when the server boots (handy on PaaS deploys)
MIGRATE_ON_START=false
# "starter" = on first boot of an empty database, create settings, levels, rewards and aisles (no demo data)
SEED_ON_START=

# Signs session/onboarding JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public HTTPS URL of the app (Telegram requires HTTPS for Mini Apps).
# Detected automatically on Render/Railway. In local dev with a tunnel, use the tunnel URL.
PUBLIC_URL=http://localhost:5173

# ── Telegram ────────────────────────────────────────────────
# From @BotFather. Without it, Telegram login is unavailable (use DEV_LOGIN_ENABLED)
# and all bot notifications are SIMULATED (logged + stored, not sent).
TELEGRAM_BOT_TOKEN=
# Bot username without @, used to build QR/deep links: t.me/<username>/<short_name>?startapp=store
TELEGRAM_BOT_USERNAME=
# Mini App short name created with /newapp in BotFather (optional; if empty we link to the bot's Main Mini App)
TELEGRAM_MINIAPP_SHORT_NAME=
# off | polling (local dev) | webhook (production, requires HTTPS PUBLIC_URL)
TELEGRAM_BOT_MODE=off
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token on webhook calls
TELEGRAM_WEBHOOK_SECRET=
# Set the bot's chat menu button to open the Mini App on startup (needs HTTPS PUBLIC_URL)
TELEGRAM_SET_MENU_BUTTON=true
# Reject Telegram initData older than this (seconds)
INITDATA_MAX_AGE_SECONDS=86400
# Comma-separated Telegram user IDs that become shop admins on login
ADMIN_TELEGRAM_IDS=

# auto = send via Telegram if a bot token is set, otherwise simulate; simulate = never send
NOTIFICATIONS_MODE=auto

# Language shown before a customer chooses one (they pick Khmer or English on their first visit): km | en
DEFAULT_LANGUAGE=km

# ── Development helpers ─────────────────────────────────────
# Shows "Dev login" buttons when the app is opened outside Telegram. Forced off in production.
DEV_LOGIN_ENABLED=true

# Product photo uploads (local disk; use object storage in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=3
