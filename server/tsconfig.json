{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["src", "test", "drizzle.config.ts", "vitest.config.ts"]
}
